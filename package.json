{
  "name": "taskbook",
  "productName": "Taskbook",
  "version": "0.4.0",
  "description": "Tasks, boards & notes for the command-line habitat",
  "repository": "klaudiosinani/taskbook",
  "license": "MIT",
  "author": {
    "name": "Klaudio Sinani",
    "email": "klaudiosinani@protonmail.ch",
    "url": "https://klaudiosinani.com"
  },
  "bin": {
    "tb": "cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src",
    "cli.js",
    "index.js"
  ],
  "keywords": [
    "task",
    "board",
    "note",
    "todo",
    "notebook",
    "command",
    "line",
    "console",
    "cli",
    "app"
  ],
  "configuration": {
    "default": {
      "taskbookDirectory": "~",
      "displayCompleteTasks": true,
      "displayProgressOverview": true
    }
  },
  "scripts": {
    "test": "xo && npm run unit",
    "unit": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "chalk": "^2.4.1",
    "clipboardy": "^1.2.3",
    "meow": "^5.0.0",
    "signale": "1.4.0",
    "update-notifier": "^2.5.0"
  },
  "devDependencies": {
    "xo": "0.59.3"
  },
  "xo": {
    "space": 2,
    "rules": {
      "unicorn/prefer-module": "off",
      "unicorn/no-array-for-each": "off",
      "comma-dangle": "off",
      "n/prefer-global/process": "off",
      "object-curly-newline": "off",
      "import/extensions": "off",
      "unicorn/prevent-abbreviations": "off",
      "unicorn/switch-case-braces": "off",
      "unicorn/prefer-includes": "off",
      "unicorn/prefer-node-protocol": "off",
      "object-curly-spacing": "off",
      "unicorn/no-nested-ternary": "off",
      "unicorn/prefer-number-properties": "off",
      "unicorn/no-process-exit": "off",
      "unicorn/prefer-string-replace-all": "off",
      "unicorn/prefer-at": "off",
      "unicorn/no-array-push-push": "off",
      "unicorn/explicit-length-check": "off",
      "prefer-object-spread": "off"
    },
    "overrides": [
      {
        "files": "test/*.js",
        "rules": {
          "n/no-unsupported-features/node-builtins": "off"
        }
      }
    ]
  }
}
