{
  "name": "ekko",
  "description": "The ekko task board for agents: an MCP server with the resume view, the work order, one item in context and structured writes; the board's resume view added to context when a session starts, with the project's memory page when the board's folder holds one; the board drawn in the session's task list under the spinner; a session woken when what it waits on is over; the Bash calls a gotcha's cue names refused, once the user turns the cue on; and a session ekko agents started kept from pushing, releasing and starting sessions, marked, on the board and in its window, while it waits on the user, and closed once its tasks are finished.",
  "homepage": "https://github.com/thiagoproldan/ekko",
  "license": "MIT",
  "mcpServers": {
    "ekko": {
      "command": "ekko",
      "args": ["--mcp"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "ekko --guard --hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --memory --hook"
          },
          {
            "type": "command",
            "command": "ekko --prime --hook"
          },
          {
            "type": "command",
            "command": "ekko --tasklist --hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__plugin_ekko_ekko__(create|set_state|force_state|edit|update|link|batch|stash|trash|phases)",
        "hooks": [
          {
            "type": "command",
            "command": "ekko --tasklist --hook"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog|elicitation_url_dialog|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "ElicitationResult": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ekko --born --hook"
          }
        ]
      }
    ],
    "FileChanged": [
      {
        "matcher": "storage.json",
        "hooks": [
          {
            "type": "command",
            "command": "ekko --tasklist --hook"
          },
          {
            "type": "command",
            "command": "ekko --wake --hook",
            "asyncRewake": true,
            "rewakeMessage": "ekko:",
            "rewakeSummary": "ekko woke this session"
          }
        ]
      }
    ]
  }
}
